# Provider API keys for agent-with-dsh.
# Copy to .env and fill in the ones you use (or export them in your shell).
# DSH profiles resolve the same keys through ~/.dsh/.credentials.yaml.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama is keyless — just have the server running on localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434/v1
