{
  "name": "agent-with-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A LangChain-style TypeScript framework for building your own agent on the DeepSeek Harness (DSH): configurable multi-provider models (DeepSeek, OpenAI, Anthropic, OpenRouter, Ollama), tools, sessions, streaming, and graph/SPARC workflows.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
